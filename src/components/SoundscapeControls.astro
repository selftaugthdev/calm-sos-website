---
const { mode='ocean', compact=false, labels } = Astro.props as { mode?: 'ocean'|'rain'; compact?: boolean; labels: Record<string,string> };
---
<section class:list={['soundscape', 'surface', {compact}]} data-soundscape data-mode={mode} data-play-label={mode === 'rain' ? labels.playRain : labels.playOcean} data-pause-label={mode === 'rain' ? labels.pauseRain : labels.pauseOcean} aria-label={mode === 'rain' ? labels.rain : labels.ocean}>
  <div class="sound-copy"><p class="eyebrow">{mode === 'rain' ? labels.rain : labels.ocean}</p>{mode === 'rain' && <p class="tag">{labels.rainTag}</p>}<p class="muted">{labels.soundDescription}</p></div>
  <div class="sound-controls"><button class="button button-secondary" type="button" data-play>{mode === 'rain' ? labels.playRain : labels.playOcean}</button><label>{labels.volume}<input type="range" min="0" max="100" value="35" data-volume aria-label={labels.volume}/></label>{mode === 'rain' && <label class="toggle"><input type="checkbox" data-thunder/> {labels.thunder}</label>}<label>{labels.sleepTimer}<select data-sleep aria-label={labels.sleepTimer}><option value="0">{labels.noTimer}</option><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="60">60 minutes</option></select></label><p class="timer" data-sleep-status aria-live="polite"></p><button class="text-button" type="button" data-cancel hidden>{labels.cancelTimer}</button><p class="error" data-error hidden><span>Sound could not start.</span> <button class="text-button" type="button" data-retry>{labels.retry}</button></p></div>
</section>
<script>
  // @ts-nocheck
  class AmbientSound {
    constructor(root){this.root=root;this.mode=root.dataset.mode;this.ctx=null;this.master=null;this.nodes=[];this.playing=false;this.sleepEnd=0;this.sleepInterval=null;this.thunderInterval=null;this.play=root.querySelector('[data-play]');this.volume=root.querySelector('[data-volume]');this.error=root.querySelector('[data-error]');this.sleep=root.querySelector('[data-sleep]');this.status=root.querySelector('[data-sleep-status]');this.cancel=root.querySelector('[data-cancel]');this.thunder=root.querySelector('[data-thunder]');this.play.addEventListener('click',()=>this.toggle());this.volume.addEventListener('input',()=>this.setVolume());this.sleep.addEventListener('change',()=>this.setSleep());this.cancel.addEventListener('click',()=>this.clearSleep());this.root.querySelector('[data-retry]').addEventListener('click',()=>this.toggle(true));this.thunder?.addEventListener('change',()=>this.thunder.checked&&this.playing?this.beginThunder():this.endThunder());document.addEventListener('calm-sos-stop-sound',event=>{if(event.detail!==this&&this.playing)this.stop()}); }
    noise(seconds=4){const buffer=this.ctx.createBuffer(1,this.ctx.sampleRate*seconds,this.ctx.sampleRate);const data=buffer.getChannelData(0);for(let i=0;i<data.length;i++)data[i]=Math.random()*2-1;const source=this.ctx.createBufferSource();source.buffer=buffer;source.loop=true;return source;}
    async start(){try{document.dispatchEvent(new CustomEvent('calm-sos-stop-sound',{detail:this}));this.ctx=this.ctx||new window.AudioContext();await this.ctx.resume();this.master=this.ctx.createGain();this.master.connect(this.ctx.destination);this.setVolume();const noise=this.noise();const filter=this.ctx.createBiquadFilter();filter.type=this.mode==='rain'?'highpass':'lowpass';filter.frequency.value=this.mode==='rain'?850:520;const gain=this.ctx.createGain();gain.gain.value=this.mode==='rain'?.20:.34;noise.connect(filter).connect(gain).connect(this.master);noise.start();this.nodes=[noise];if(this.mode==='ocean'){const swell=this.ctx.createOscillator(), swellGain=this.ctx.createGain();swell.type='sine';swell.frequency.value=.085;swellGain.gain.value=.14;swell.connect(swellGain).connect(gain.gain);swell.start();this.nodes.push(swell);}this.playing=true;this.play.textContent=this.root.dataset.pauseLabel;if(this.thunder?.checked)this.beginThunder();}catch(e){this.error.hidden=false;}}
    stop(){this.nodes.forEach(n=>{try{n.stop()}catch(e){}});this.nodes=[];this.playing=false;this.endThunder();this.play.textContent=this.root.dataset.playLabel;}
    toggle(){this.error.hidden=true;if(this.playing){this.stop();return;}this.start();}
    setVolume(){if(this.master)this.master.gain.value=(Number(this.volume.value)/100)*.55;}
    beginThunder(){this.endThunder();const rumble=()=>{if(!this.playing||!this.thunder?.checked)return;const source=this.noise(3), filter=this.ctx.createBiquadFilter(), gain=this.ctx.createGain();filter.type='lowpass';filter.frequency.value=95;gain.gain.setValueAtTime(.001,this.ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.028,this.ctx.currentTime+.7);gain.gain.exponentialRampToValueAtTime(.001,this.ctx.currentTime+3);source.connect(filter).connect(gain).connect(this.master);source.loop=false;source.start();source.stop(this.ctx.currentTime+3.1);};this.thunderInterval=setInterval(rumble,45000);}
    endThunder(){if(this.thunderInterval)clearInterval(this.thunderInterval);this.thunderInterval=null;}
    setSleep(){const minutes=Number(this.sleep.value);this.clearSleep();if(!minutes)return;this.sleepEnd=Date.now()+minutes*60000;this.cancel.hidden=false;this.sleepInterval=setInterval(()=>{const left=Math.max(0,this.sleepEnd-Date.now());const m=Math.ceil(left/60000);this.status.textContent=`${m} minute${m===1?'':'s'} remaining.`;if(!left){this.stop();this.clearSleep();this.status.textContent='Sound stopped.';}},1000);}
    clearSleep(){if(this.sleepInterval)clearInterval(this.sleepInterval);this.sleepInterval=null;this.sleepEnd=0;this.status.textContent='';this.cancel.hidden=true;}
  }
  document.querySelectorAll('[data-soundscape]').forEach(root=>new AmbientSound(root));
</script>
<style>.soundscape{padding:1.35rem;display:grid;gap:1rem}.sound-copy p{margin:.3rem 0}.tag{font-size:1.25rem;font-weight:750}.sound-controls{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.sound-controls label{font-size:.9rem;font-weight:700;display:grid;gap:.25rem}.sound-controls input[type="range"]{accent-color:var(--primary)}select{font:inherit;padding:.35rem;border:1px solid var(--border);border-radius:.5rem;background:var(--card);color:var(--text)}.toggle{display:flex!important;align-items:center;gap:.4rem}.timer,.error{width:100%;margin:0;color:var(--muted);font-size:.9rem}.text-button{border:0;background:none;padding:0;color:var(--primary);text-decoration:underline;cursor:pointer;font:inherit}.compact .sound-copy .muted{display:none}</style>
