---
const { labels, lang }=Astro.props as { labels:Record<string,string>; lang:string };
const reminders = { en:['You don’t have to solve everything at once.','You can take a pause before deciding what comes next.','One small step is enough for now.','You can notice this moment without needing to fix it.','It is okay to take your time with what comes next.','You can be kind to yourself while things are difficult.'], nl:['Je hoeft niet alles tegelijk op te lossen.','Je kunt pauzeren voordat je beslist wat er hierna komt.','Eén kleine stap is genoeg voor nu.','Je kunt dit moment opmerken zonder het te moeten oplossen.','Het is oké om tijd te nemen voor wat hierna komt.','Je mag mild zijn voor jezelf als het moeilijk is.'], fr:['Vous n’avez pas à tout résoudre d’un coup.','Vous pouvez faire une pause avant de décider de la suite.','Un petit pas suffit pour le moment.','Vous pouvez remarquer ce moment sans devoir le réparer.','Vous pouvez prendre votre temps pour ce qui vient ensuite.','Vous pouvez être bienveillant envers vous-même quand c’est difficile.'] }[lang as 'en'|'nl'|'fr'];
---
<section class="reminder surface" data-reminder data-items={JSON.stringify(reminders)}><p class="reminder-text" data-reminder-text aria-live="polite">{reminders[0]}</p><button class="button button-primary" data-show type="button">{labels.showReminder}</button><div class="follow-up" data-follow hidden><button class="button button-secondary" data-another type="button">{labels.anotherReminder}</button><a class="button button-quiet" href={`/${lang}/tools/pause`}>{labels.takePause}</a><a class="button button-quiet" href={`/${lang}/calm-now`}>{labels.tryGrounding}</a></div></section>
<script is:inline>document.querySelectorAll('[data-reminder]').forEach(root=>{const items=JSON.parse(root.dataset.items);let last=-1;const text=root.querySelector('[data-reminder-text]'),show=root.querySelector('[data-show]'),follow=root.querySelector('[data-follow]');const choose=()=>{let next=Math.floor(Math.random()*items.length);if(items.length>1)while(next===last)next=Math.floor(Math.random()*items.length);last=next;text.textContent=items[next];follow.hidden=false;show.hidden=true;};show.addEventListener('click',choose);root.querySelector('[data-another]').addEventListener('click',choose);});</script>
<style>.reminder{padding:clamp(1.5rem,5vw,3.5rem);text-align:center}.reminder-text{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:750;max-width:22ch;margin:0 auto 1.5rem}.follow-up{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap}</style>
