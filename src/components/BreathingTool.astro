---
const { lang='en' } = Astro.props as { lang?: 'en'|'nl'|'fr' };
const copy = {
 en:{eyebrow:'Guided breathing',title:'Follow the breathing circle',intro:'Choose a breathing pattern, then start the guide. The circle will show you when to breathe in, hold and breathe out.',box:'Box breathing',four:'4–7–8 breathing',boxInfo:'Breathe in for 4 seconds, hold for 4, breathe out for 4, then hold for 4.',fourInfo:'Breathe in for 4 seconds, hold for 7, then breathe out for 8.',normal:'You can stop at any point or return to your normal breathing whenever you wish.',start:'Start breathing guide',pause:'Pause guide',ready:'Ready'},
 nl:{eyebrow:'Begeleid ademen',title:'Volg de ademcirkel',intro:'Kies een adempatroon en start de gids. De cirkel laat zien wanneer je inademt, vasthoudt en uitademt.',box:'Vierkant ademen',four:'4–7–8 ademen',boxInfo:'Adem 4 seconden in, houd 4 seconden vast, adem 4 seconden uit en houd opnieuw 4 seconden vast.',fourInfo:'Adem 4 seconden in, houd 7 seconden vast en adem 8 seconden uit.',normal:'Je kunt op elk moment stoppen of terugkeren naar je normale ademhaling.',start:'Start ademgids',pause:'Pauzeer gids',ready:'Klaar'},
 fr:{eyebrow:'Respiration guidée',title:'Suivez le cercle respiratoire',intro:'Choisissez un rythme, puis lancez le guide. Le cercle indique quand inspirer, retenir et expirer.',box:'Respiration carrée',four:'Respiration 4–7–8',boxInfo:'Inspirez pendant 4 secondes, retenez 4 secondes, expirez 4 secondes, puis retenez encore 4 secondes.',fourInfo:'Inspirez pendant 4 secondes, retenez 7 secondes, puis expirez pendant 8 secondes.',normal:'Vous pouvez vous arrêter à tout moment ou revenir à votre respiration naturelle.',start:'Démarrer le guide',pause:'Mettre le guide en pause',ready:'Prêt'}
}[lang];
---
<section class="breathing surface" aria-labelledby="breathing-title" data-breathing><div><p class="eyebrow">{copy.eyebrow}</p><h2 id="breathing-title">{copy.title}</h2><p class="muted">{copy.intro}</p><fieldset><legend class="sr">Breathing pattern</legend><button class="choice active" data-pattern="box" type="button">{copy.box}</button><button class="choice" data-pattern="478" type="button">{copy.four}</button></fieldset><p class="pattern-info" data-pattern-info>{copy.boxInfo}</p><p class="muted normal">{copy.normal}</p><button class="button button-secondary" data-start type="button">{copy.start}</button></div><div class="orb-wrap" aria-live="polite"><div class="orb" data-orb></div><p data-count>{copy.ready}</p></div></section>
<script define:vars={{ copy }}>
  document.querySelectorAll('[data-breathing]').forEach(root=>{const patterns={box:[['Breathe in',4],['Hold',4],['Breathe out',4],['Hold',4]],'478':[['Breathe in',4],['Hold',7],['Breathe out',8]]};let chosen='box',running=false,timer;const info=root.querySelector('[data-pattern-info]'),count=root.querySelector('[data-count]'),orb=root.querySelector('[data-orb]'),start=root.querySelector('[data-start]');root.querySelectorAll('[data-pattern]').forEach(button=>button.addEventListener('click',()=>{if(running)return;chosen=button.dataset.pattern;root.querySelectorAll('[data-pattern]').forEach(item=>item.classList.toggle('active',item===button));info.textContent=chosen==='box'?copy.boxInfo:copy.fourInfo;}));const cycle=()=>{let i=0;const next=()=>{const [label,seconds]=patterns[chosen][i];let end=performance.now()+seconds*1000;orb.style.setProperty('--length',`${seconds}s`);orb.dataset.phase=label;const tick=()=>{const remain=Math.max(0,Math.ceil((end-performance.now())/1000));count.textContent=`${label} · ${remain}`;if(remain){timer=requestAnimationFrame(tick)}else{i=(i+1)%patterns[chosen].length;next()}};tick()};next()};start.addEventListener('click',()=>{running=!running;if(running){start.textContent=copy.pause;cycle()}else{cancelAnimationFrame(timer);start.textContent=copy.start;count.textContent=copy.ready;orb.dataset.phase='';}});});
</script>
<style>.breathing{padding:clamp(1.3rem,4vw,3rem);display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:center}.breathing h2{margin:.4rem 0}fieldset{border:0;padding:0;margin:1.25rem 0 .5rem}.choice{background:transparent;border:1px solid var(--border);color:var(--text);border-radius:999px;padding:.5rem .75rem;margin:.2rem;cursor:pointer}.choice.active{background:var(--primary);color:var(--primary-ink);border-color:var(--primary)}.pattern-info{font-weight:700;margin:.7rem 0}.normal{font-size:.92rem}.orb-wrap{text-align:center;font-weight:750}.orb{width:min(45vw,220px);aspect-ratio:1;border-radius:50%;margin:auto;background:radial-gradient(circle at 34% 30%,#ded8ff,var(--primary));box-shadow:0 0 0 1rem color-mix(in srgb,var(--primary) 10%,transparent);transition:transform 4s ease-in-out}.orb[data-phase="Breathe in"]{animation:inhale var(--length) ease-in-out infinite alternate}.orb[data-phase="Breathe out"]{animation:exhale var(--length) ease-in-out infinite alternate}@keyframes inhale{to{transform:scale(1.25)}}@keyframes exhale{to{transform:scale(.76)}}.sr{position:absolute;left:-9999px}@media(max-width:700px){.breathing{grid-template-columns:1fr}.orb{width:180px}}</style>
