---
import SoundscapeControls from './SoundscapeControls.astro';
const { labels }=Astro.props as { labels:Record<string,string> };
---
<section class="pause-tool surface" data-pause-tool><div class="pause-face"><p class="eyebrow">Two minutes</p><p class="count" data-count aria-live="off">2:00</p><p class="status" data-status aria-live="polite"> </p></div><div class="pause-actions"><button class="button button-primary" data-start type="button">{labels.startPause}</button><button class="button button-quiet" data-finish type="button" hidden>{labels.finish}</button><button class="text-button" data-hide type="button">{labels.hideTimer}</button></div><div data-complete aria-live="polite" hidden><p class="complete">{labels.done}</p><button class="button button-secondary" data-again type="button">{labels.again}</button><button class="button button-quiet" data-listen type="button">{labels.keepListening}</button></div></section>
<div class="pause-sound"><SoundscapeControls mode="ocean" compact labels={labels}/></div>
<script define:vars={{ labels }}>
  document.querySelectorAll('[data-pause-tool]').forEach(root=>{let started=0,pausedAt=0,pausedFor=0,raf=null,running=false;const count=root.querySelector('[data-count]'),status=root.querySelector('[data-status]'),start=root.querySelector('[data-start]'),finish=root.querySelector('[data-finish]'),hide=root.querySelector('[data-hide]'),complete=root.querySelector('[data-complete]');const format=ms=>{const sec=Math.ceil(ms/1000);return `${Math.floor(sec/60)}:${String(sec%60).padStart(2,'0')}`};const update=()=>{if(!running)return;const left=Math.max(0,120000-(performance.now()-started-pausedFor));count.textContent=format(left);if(left<=0){running=false;start.hidden=true;finish.hidden=true;complete.hidden=false;status.textContent='';return;}raf=requestAnimationFrame(update)};const begin=()=>{if(pausedAt){pausedFor+=performance.now()-pausedAt;pausedAt=0;}else started=performance.now();running=true;start.textContent=labels.pause;finish.hidden=false;update()};start.addEventListener('click',()=>{if(running){running=false;pausedAt=performance.now();cancelAnimationFrame(raf);start.textContent=labels.resume;status.textContent='Paused.';}else begin()});finish.addEventListener('click',()=>{running=false;cancelAnimationFrame(raf);start.hidden=true;finish.hidden=true;complete.hidden=false;status.textContent='';});hide.addEventListener('click',()=>{count.hidden=!count.hidden;hide.textContent=count.hidden?labels.showTimer:labels.hideTimer});root.querySelector('[data-again]').addEventListener('click',()=>{started=0;pausedAt=0;pausedFor=0;count.textContent='2:00';count.hidden=false;hide.textContent=labels.hideTimer;complete.hidden=true;start.hidden=false;start.textContent=labels.startPause;});root.querySelector('[data-listen]').addEventListener('click',()=>document.querySelector('[data-soundscape] [data-play]')?.click());});
</script>
<style>.pause-tool{padding:clamp(1.5rem,5vw,3.5rem);text-align:center}.pause-face{padding:1rem}.count{font-size:clamp(4rem,13vw,7rem);font-weight:800;letter-spacing:-.07em;margin:.2rem 0}.status{min-height:1.5rem;color:var(--muted)}.pause-actions{display:flex;justify-content:center;align-items:center;gap:.7rem;flex-wrap:wrap}.text-button{border:0;background:transparent;color:var(--primary);font:inherit;text-decoration:underline;cursor:pointer}.complete{font-size:1.2rem;font-weight:700;max-width:38ch;margin:2rem auto 1rem}.pause-sound{max-width:720px;margin:1rem auto 0}</style>
