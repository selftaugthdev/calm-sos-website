---
import { type Language } from '../config'; const { lang='en' } = Astro.props as { lang?: Language };
---
<footer><div class="shell grid"><div><a class="brand" href={`/${lang}`}><img src="/images/New%20LOGO%20Calm%20SOS.png" alt=""/>Calm SOS</a><p class="muted">A little more room to breathe.</p></div><div><strong>Support</strong><a href={`/${lang}/crisis-help`}>Crisis help</a><a href={`/${lang}/medical-disclaimer`}>Medical disclaimer</a><a href={`/${lang}/contact`}>Contact</a></div><div><strong>Legal</strong><a href={`/${lang}/privacy`}>Privacy</a><a href={`/${lang}/terms`}>Terms</a><a href={`/${lang}/about`}>About</a></div></div><div class="shell tiny">© {new Date().getFullYear()} Calm SOS. This site offers information, not medical care.</div></footer>
<style>footer{margin-top:5rem;padding:3rem 0 1.5rem;border-top:1px solid var(--border)}.grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:2rem}.grid a{display:block;margin-top:.45rem}.brand{font-weight:800;color:var(--text);text-decoration:none;font-size:1.2rem;display:flex!important;align-items:center;gap:.55rem}.brand img{width:2.6rem;height:2.6rem;object-fit:cover;border-radius:50%;box-shadow:0 2px 10px #45246622}.tiny{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);color:var(--muted);font-size:.85rem}@media(max-width:620px){.grid{grid-template-columns:1fr}}</style>
