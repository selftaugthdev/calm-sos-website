---
const { measurementId = '' } = Astro.props;
---
<div class="cookie surface" hidden data-cookie><p><strong>Your privacy matters.</strong> We use only essential storage unless you choose to allow Google Analytics. You can change this later in site settings.</p><div><button class="button button-quiet" data-decline>Keep analytics off</button><button class="button button-secondary" data-accept>Allow analytics</button></div></div>
<script define:vars={{ measurementId }}>
  /** @type {any} */
  const analyticsWindow = window;
  const loadAnalytics = () => {
    if (!measurementId || analyticsWindow.calmSosAnalyticsLoaded) return;
    analyticsWindow.calmSosAnalyticsLoaded = true;
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = (...args) => analyticsWindow.dataLayer?.push(args);
    analyticsWindow.gtag('js', new Date());
    analyticsWindow.gtag('config', measurementId, { anonymize_ip: true });
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.append(script);
  };
  const box = document.querySelector('[data-cookie]');
  const consent = localStorage.getItem('calm-sos-consent');
  if (!consent) box?.removeAttribute('hidden');
  if (consent === 'analytics') loadAnalytics();
  document.querySelector('[data-decline]')?.addEventListener('click', () => {
    localStorage.setItem('calm-sos-consent', 'essential');
    box?.setAttribute('hidden', '');
  });
  document.querySelector('[data-accept]')?.addEventListener('click', () => {
    localStorage.setItem('calm-sos-consent', 'analytics');
    box?.setAttribute('hidden', '');
    loadAnalytics();
  });
</script>
<style>.cookie{position:fixed;z-index:10;bottom:1rem;left:1rem;right:1rem;margin:auto;max-width:620px;padding:1rem;box-shadow:0 12px 45px #0002}.cookie p{margin:0 0 .75rem}.cookie div{display:flex;gap:.5rem;flex-wrap:wrap}.cookie .button{min-height:2.4rem}</style>
