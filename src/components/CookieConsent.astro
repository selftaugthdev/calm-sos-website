<div class="cookie surface" hidden data-cookie><p><strong>Your privacy matters.</strong> We use only essential storage unless you choose privacy-friendly analytics. You can change this later in site settings.</p><div><button class="button button-quiet" data-decline>Keep analytics off</button><button class="button button-secondary" data-accept>Allow analytics</button></div></div>
<script is:inline>const box=document.querySelector('[data-cookie]');if(!localStorage.getItem('calm-sos-consent'))box.hidden=false;document.querySelector('[data-decline]')?.addEventListener('click',()=>{localStorage.setItem('calm-sos-consent','essential');box.hidden=true});document.querySelector('[data-accept]')?.addEventListener('click',()=>{localStorage.setItem('calm-sos-consent','analytics');box.hidden=true;/* Add Plausible only after consent here. */});</script>
<style>.cookie{position:fixed;z-index:10;bottom:1rem;left:1rem;right:1rem;margin:auto;max-width:620px;padding:1rem;box-shadow:0 12px 45px #0002}.cookie p{margin:0 0 .75rem}.cookie div{display:flex;gap:.5rem;flex-wrap:wrap}.cookie .button{min-height:2.4rem}</style>
