---
import ThemeToggle from './ThemeToggle.astro';
import { languageNames, type Language } from '../config';
const { lang = 'en', transparent = false } = Astro.props as { lang?: Language; transparent?: boolean };
---
<a class="skip" href="#main">Skip to content</a>
<header class:list={{ transparent }}><div class="shell row"><a class="brand" href={`/${lang}`} aria-label="Calm SOS home"><img src="/images/New%20LOGO%20Calm%20SOS.png" alt=""/>Calm SOS</a><nav aria-label="Primary navigation"><a href={`/${lang}/calm-now`}>Exercises</a><a href={`/${lang}/learn`}>Guides</a><a href={`/${lang}/tools`}>Tools</a><a href={`/${lang}/about`}>About</a></nav><div class="controls"><ThemeToggle /><details><summary aria-label="Choose language">{lang.toUpperCase()}</summary><div class="langs">{Object.entries(languageNames).map(([code,name]) => <a href={`/${code}`}>{name}</a>)}</div></details></div></div></header>
<style>header{position:relative;padding:1rem 0;border-bottom:1px solid color-mix(in srgb,var(--border) 75%,transparent);background:color-mix(in srgb,var(--card) 55%,transparent);backdrop-filter:blur(14px);z-index:5}header.transparent{position:absolute;inset:0 0 auto;background:linear-gradient(180deg,#f7faf5c7,transparent);border:0}.row{display:flex;align-items:center;gap:1rem;justify-content:space-between}.brand{color:var(--text);font-weight:800;text-decoration:none;font-size:1.2rem;display:flex;align-items:center;gap:.5rem}.brand img{width:2.15rem;height:2.15rem;object-fit:cover;border-radius:50%;box-shadow:0 4px 14px #38515325}nav{display:flex;gap:1rem}nav a{color:var(--text);font-size:.95rem;text-decoration:none}nav a:hover{color:var(--primary)}.controls{display:flex;align-items:center;gap:.5rem}details{position:relative}summary{cursor:pointer;list-style:none;font-size:.82rem}.langs{position:absolute;right:0;top:1.8rem;background:var(--card);border:1px solid var(--border);border-radius:.8rem;padding:.5rem;z-index:3;min-width:7rem;box-shadow:0 12px 30px #38515318}.langs a{display:block;padding:.3rem}@media(max-width:720px){nav a:not(:first-child){display:none}.theme span{display:none}}</style>
