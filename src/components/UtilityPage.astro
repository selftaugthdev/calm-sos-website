---
import BaseLayout from './BaseLayout.astro'; import CrisisBox from './CrisisBox.astro'; import type { Language } from '../config';
const { lang, page }=Astro.props as {lang:Language;page:'about'|'contact'|'privacy'|'terms'|'medical-disclaimer'|'crisis-help'};
const pages={
 about:{title:'About Calm SOS',description:'Calm SOS is a gentle wellbeing project by indie developer Thierry De Belder in Belgium.',body:`Calm SOS was created by Thierry De Belder, an independent developer in Belgium. The intention is simple: make a calm, useful space that feels respectful when someone is having a hard moment.\n\nThe app and this site are not a substitute for therapy, medical care or crisis services. They are designed as a small companion for grounding, breathing and learning. Claims about features, availability and pricing will be verified before launch.`},
 contact:{title:'Contact',description:'Contact Calm SOS.',body:`Questions, corrections or accessibility feedback are welcome. Email hello@calmsos.com.\n\nIf you are looking for urgent support, please do not wait for an email reply. Visit the crisis help page or contact a local emergency service.`},
 privacy:{title:'Privacy policy',description:'How Calm SOS handles privacy on this website.',body:`Calm SOS keeps this site intentionally private. No non-essential analytics load until you choose to allow them in the consent banner. Essential local storage remembers your theme and cookie choice on your device.\n\nIf privacy-friendly analytics are enabled after consent, use a provider configured without advertising profiles or cross-site tracking. Before launch, add the selected provider, retention period, data controller details and any processor agreements here.\n\nFor privacy requests, email hello@calmsos.com.`},
 terms:{title:'Terms of use',description:'Terms for using the Calm SOS website.',body:`Use this site for personal, informational purposes. The content is not medical advice, a diagnosis or an emergency service. Do not delay seeking professional help because of something on this site.\n\nContent may change as it is reviewed. Links to external services are provided for convenience and remain their own responsibility.`},
 'medical-disclaimer':{title:'Medical disclaimer',description:'Important information about the limits of Calm SOS health content.',body:`Calm SOS provides general wellbeing information and self-guided exercises. It does not provide medical advice, diagnosis, treatment or a replacement for care from a qualified professional.\n\nIf you have symptoms that concern you, speak with a healthcare professional. If there is an emergency or you feel unable to stay safe, contact emergency or crisis support right away.`},
 'crisis-help':{title:'Crisis help',description:'Urgent support information and helplines for Belgium, the EU and other countries.',body:''}
}; const data=pages[page];
---
<BaseLayout lang={lang} title={`${data.title} | Calm SOS`} description={data.description}><article class="shell page"><p class="eyebrow">Calm SOS</p><h1>{data.title}</h1>{page==='crisis-help'?<><p class="lead">If you might hurt yourself, cannot stay safe, or are in immediate danger, call emergency services now. In the EU, call <a href="tel:112">112</a>.</p><CrisisBox /><h2>Belgium, verify before launch</h2><ul><li><a href="https://www.zelfmoord1813.be/">Zelfmoordlijn 1813</a>, call 1813</li><li><a href="https://www.tele-onthaal.be/">Tele-Onthaal</a>, call 106</li><li><a href="https://www.preventionsuicide.be/">Centre de Prévention du Suicide</a>, French speakers, call 0800 32 123</li></ul><h2>Other countries</h2><p>Find a local, verified helpline through <a href="https://findahelpline.com">findahelpline.com</a>. Availability and numbers can change, so verify them before relying on this page.</p></>:data.body.split('\n\n').map(p=><p>{p}</p>)}</article></BaseLayout>
<style>.page{max-width:780px;padding-top:4rem;min-height:55vh}.page h1{margin:.4rem 0 1.2rem}.page h2{margin-top:2.5rem}.lead{font-size:1.2rem;color:var(--muted)}</style>
