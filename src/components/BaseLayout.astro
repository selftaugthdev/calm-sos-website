---
import '../styles/global.css'; import Header from './Header.astro'; import Footer from './Footer.astro'; import CookieConsent from './CookieConsent.astro'; import { site, languages, type Language } from '../config';
const { title, description, lang='en', schema, transparentHeader=false, bodyClass='' } = Astro.props as { title:string; description:string; lang?:Language; schema?:object; transparentHeader?:boolean; bodyClass?:string };
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="icon" href="/images/New%20LOGO%20Calm%20SOS.png"/><link rel="canonical" href={canonical}/>{languages.map(l => <link rel="alternate" hreflang={l} href={`${site.url}/${l}${Astro.url.pathname.replace(/^\/(en|nl|fr)/, '')}`}/>) }<link rel="alternate" hreflang="x-default" href={`${site.url}/en${Astro.url.pathname.replace(/^\/(en|nl|fr)/, '')}`}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Calm SOS"/><meta name="theme-color" content="#6A5FA8"/>{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}</head><body class={bodyClass}><Header lang={lang} transparent={transparentHeader}/><main id="main"><slot /></main><Footer lang={lang}/><CookieConsent /><script is:inline>document.documentElement.dataset.theme=localStorage.getItem('calm-sos-theme')||'';</script></body></html>
