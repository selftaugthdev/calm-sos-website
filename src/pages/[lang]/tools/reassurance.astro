---
import BaseLayout from '../../../components/BaseLayout.astro'; import ReminderTool from '../../../components/ReminderTool.astro'; import { toolCopy } from '../../../data/tool-copy'; import { languages, type Language } from '../../../config';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))} const {lang='en'}=(Astro.params ?? {}) as {lang?:Language}; const copy=toolCopy[lang];
---
<BaseLayout lang={lang} title={`${copy.reminderTitle} | Calm SOS`} description="A few gentle, grounded reminders for a difficult moment."><section class="shell intro"><p class="eyebrow">Free browser tool</p><h1>{copy.reminderTitle}</h1><p class="lead">{copy.reminderIntro}</p></section><main class="shell tool-page"><ReminderTool labels={copy} lang={lang}/></main></BaseLayout>
<style>.intro{padding:4.5rem 0 2rem;max-width:760px}.intro h1{margin:.4rem 0}.lead{font-size:1.2rem;color:var(--muted)}.tool-page{max-width:860px;margin-bottom:4rem}</style>
