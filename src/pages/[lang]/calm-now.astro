---
import BaseLayout from '../../components/BaseLayout.astro'; import BreathingTool from '../../components/BreathingTool.astro'; import { languages, type Language } from '../../config';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))} const {lang='en'}=(Astro.params ?? {}) as {lang?:Language};
---
<BaseLayout lang={lang} title="Guided breathing and grounding | Calm SOS" description="Follow a guided breathing circle or try a 5-4-3-2-1 grounding exercise in your browser.">
<section class="shell page-hero"><p class="eyebrow">Free browser exercises</p><h1>Take a moment with a guided exercise.</h1><p class="lead">Follow the breathing circle, or try a grounding exercise by noticing what’s around you. Go at your own pace, and stop whenever you like.</p></section>
<div class="shell"><BreathingTool lang={lang}/></div>
<section class="shell grounding" aria-labelledby="grounding"><p class="eyebrow">5–4–3–2–1 grounding</p><h2 id="grounding">Notice what’s around you</h2><p class="muted">The 5–4–3–2–1 grounding exercise guides you through things you can see, feel, hear, smell and taste.</p><div class="walk surface" data-grounding><div class="step active" data-step><span>5</span><h3>Name five things you can see</h3><p>Let your eyes rest on ordinary details. Light, colour, a shape, something familiar.</p></div><div class="step" data-step><span>4</span><h3>Notice four things you can feel</h3><p>Your feet on the floor, fabric against your skin, the chair holding you.</p></div><div class="step" data-step><span>3</span><h3>Listen for three sounds</h3><p>Near or far, steady or changing. No sound needs to be special.</p></div><div class="step" data-step><span>2</span><h3>Find two things you can smell</h3><p>Perhaps the room, fresh air, a drink, or simply notice what is present.</p></div><div class="step" data-step><span>1</span><h3>Name one thing you can taste</h3><p>A sip of water can be enough. Or notice the inside of your mouth.</p></div><div class="grounding-actions"><button class="button button-secondary" data-next type="button">Start grounding exercise</button><button class="button button-quiet" data-skip type="button">Skip this step</button><button class="button button-quiet" data-stop type="button">Stop exercise</button></div></div></section>
<section class="shell after surface" hidden data-after><h2>You can take the next few minutes gently.</h2><p class="muted">You may feel different, or exactly the same. Either is okay.</p><a class="button button-primary" href={`/${lang}/tools`}>Explore more free tools</a></section>
</BaseLayout>
<script is:inline>const steps=[...document.querySelectorAll('[data-step]')],next=document.querySelector('[data-next]'),skip=document.querySelector('[data-skip]'),stop=document.querySelector('[data-stop]'),after=document.querySelector('[data-after]');let current=-1;const reset=()=>{current=-1;steps.forEach((s,i)=>s.classList.toggle('active',i===0));next.textContent='Start grounding exercise';next.hidden=false;skip.hidden=false;};const advance=()=>{current++;steps.forEach((s,i)=>s.classList.toggle('active',i===current));next.textContent='Next step';if(current>=steps.length-1){next.hidden=true;skip.hidden=true;after.hidden=false;after.scrollIntoView({behavior:'smooth',block:'center'});}};next?.addEventListener('click',advance);skip?.addEventListener('click',advance);stop?.addEventListener('click',reset);</script>
<style>.grounding{padding:4rem 0;max-width:780px}.walk{padding:clamp(1.5rem,5vw,2.5rem)}.step{display:none;min-height:205px}.step.active{display:block}.step span{display:grid;place-items:center;width:3rem;height:3rem;border-radius:50%;background:var(--accent);font-size:1.35rem;font-weight:800;box-shadow:0 0 0 .5rem color-mix(in srgb,var(--accent) 22%,transparent)}.step h3{font-size:1.7rem;margin:.8rem 0}.grounding-actions{display:flex;gap:.6rem;flex-wrap:wrap}.after{padding:2rem;max-width:780px;margin-bottom:3rem}</style>
