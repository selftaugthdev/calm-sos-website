---
import BaseLayout from '../../../components/BaseLayout.astro'; import { clusters } from '../../../data/learn'; import { languages, type Language } from '../../../config';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))} const {lang='en'}=(Astro.params ?? {}) as {lang?:Language};
---
<BaseLayout lang={lang} title="Learn about calm living | Calm SOS" description="Practical, plain-language guides for anxiety, panic attacks, trauma, sleep, stress and calmer daily life."><section class="shell intro"><p class="eyebrow">Calm living hub</p><h1>Clear information for difficult feelings and full days.</h1><p class="lead">Read at your own pace. Every guide is written to be calm, useful and honest about when professional support matters.</p></section><section class="shell grid">{clusters.map(c=><a class="surface cluster" href={`/${lang}/learn/${c.slug}`}><p class="eyebrow">Topic</p><h2>{c.name}</h2><p class="muted">{c.desc}</p><span>Read the guide →</span></a>)}</section></BaseLayout>
<style>.intro{padding:4.5rem 0 2rem;max-width:800px}.intro h1{margin:.4rem 0}.lead{font-size:1.2rem;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.cluster{color:var(--text);text-decoration:none;padding:1.4rem;min-height:220px}.cluster h2{font-size:1.6rem;margin:.3rem 0}.cluster:hover{border-color:var(--primary)}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
