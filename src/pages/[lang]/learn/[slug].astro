---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../../components/BaseLayout.astro'; import Disclaimer from '../../../components/Disclaimer.astro'; import CrisisBox from '../../../components/CrisisBox.astro'; import AppStoreCTA from '../../../components/AppStoreCTA.astro'; import { clusters } from '../../../data/learn'; import { languages, type Language } from '../../../config';
export async function getStaticPaths(){const articles=await getCollection('articles');return languages.flatMap(lang=>articles.map(a=>({params:{lang,slug:a.id},props:{article:a}})))} const {article}=Astro.props; const {Content}=await render(article); const {lang='en'}=(Astro.params ?? {}) as {lang?:Language}; const cluster=clusters.find(c=>c.slug===article.id)!; const schema={"@context":"https://schema.org","@type":"Article","headline":article.data.title,"description":article.data.description,"dateModified":article.data.updated,"mainEntityOfPage":`https://calmsos.com/${lang}/learn/${article.id}`};
---
<BaseLayout lang={lang} title={`${article.data.title} | Calm SOS`} description={article.data.description} schema={schema}><article class="shell article"><nav class="crumb" aria-label="Breadcrumb"><a href={`/${lang}/learn`}>Learn</a> / <span>{article.data.cluster}</span></nav><p class="eyebrow">{article.data.cluster}</p><h1>{article.data.title}</h1><p class="dek">{article.data.description}</p><div class="meta">Last reviewed: {article.data.reviewed} · Reviewed by: {article.data.reviewer}</div><Disclaimer /><div class="prose"><Content /></div><section class="help"><h2>When to get professional help</h2><p>If these experiences are affecting your safety, daily life, relationships or sleep, consider talking with a GP, therapist or another qualified professional. You deserve support that fits your situation.</p><CrisisBox /></section><section class="sources"><h2>Sources</h2><ul>{article.data.sources.map(source=><li><a href={source.url}>{source.label}</a></li>)}</ul></section><AppStoreCTA compact /></article><section class="shell related"><p class="eyebrow">Continue exploring</p><h2>More in {cluster.name}</h2><div class="outlines">{cluster.supports.map(([title,keyword,...headings])=><details><summary>{title}</summary><p class="muted">Planned guide · Target phrase: {keyword}</p><ul>{headings.map(heading=><li>{heading}</li>)}</ul></details>)}</div></section></BaseLayout>
<style>.article{max-width:800px;padding-top:3rem}.crumb{font-size:.9rem;color:var(--muted);margin-bottom:2rem}.article h1{margin:.5rem 0}.dek{font-size:1.25rem;color:var(--muted)}.meta{font-size:.86rem;color:var(--muted);margin:1.5rem 0}.prose{margin-top:2rem}.help,.sources{margin-top:3rem}.sources{border-top:1px solid var(--border)}.related{max-width:800px}.outlines details{padding:1rem 0;border-top:1px solid var(--border)}.outlines summary{font-weight:750;cursor:pointer}</style>
