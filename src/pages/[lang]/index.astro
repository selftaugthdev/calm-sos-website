---
import BaseLayout from '../../components/BaseLayout.astro'; import AppStoreCTA from '../../components/AppStoreCTA.astro'; import { site, languages, type Language } from '../../config';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))}
const {lang='en'}=(Astro.params ?? {}) as {lang?:Language};
const schema={"@context":"https://schema.org","@graph":[{"@type":"Organization","name":"Calm SOS","url":"https://calmsos.com","email":site.email},{"@type":"MobileApplication","name":"Calm SOS","applicationCategory":"HealthApplication","operatingSystem":"iOS","description":site.pitch},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Calm SOS medical care?","acceptedAnswer":{"@type":"Answer","text":"No. Calm SOS offers general wellbeing tools and does not replace professional support."}},{"@type":"Question","name":"What can I use right now?","acceptedAnswer":{"@type":"Answer","text":"Try the free Calm Now breathing and grounding exercises in your browser."}}]}]};
---
<BaseLayout lang={lang} title="Calm SOS | A quieter moment when you need one" description="A gentle space for breathing, grounding and learning about anxiety, panic, sleep and stress." schema={schema} transparentHeader bodyClass="home-immersive">
<section class="hero" aria-labelledby="hero-title"><div class="hero-wash"></div><div class="shell hero-inner"><div class="hero-copy"><p class="eyebrow">When anxiety feels overwhelming</p><h1 id="hero-title">Find your footing in a difficult moment.</h1><p class="lead">Try guided breathing and grounding exercises, or explore practical information about anxiety, panic, stress and sleep.</p><div class="actions"><a class="button button-primary" href={site.appStoreUrl}>Download on the App Store</a><a class="button button-quiet" href={`/${lang}/calm-now`}>Try a breathing exercise</a></div><p class="small">The breathing and grounding exercises are free to use here in your browser.</p></div><aside class="hero-pause surface" aria-label="A gentle breathing reminder"><span class="pause-orb"></span><div><strong>Guided breathing</strong><p>Follow the circle at your own pace</p></div></aside></div></section>
<section class="shell section"><p class="eyebrow">Find a starting point</p><h2>What are you struggling with?</h2><div class="cards">{[['Feeling panicky','Read what panic can feel like, plus practical steps for the moment.','Panic attacks','feeling-panicky.png'],['Anxious thoughts','Understand anxious thoughts and find gentle ways to meet the next one.','Anxiety','anxious-thoughts.png'],["Can’t sleep",'Explore ideas for racing thoughts, hard nights and a more realistic wind-down.','Sleep','cant-sleep.png'],['Feeling overwhelmed','Learn about daily stress, work stress and recognising burnout.','Stress and burnout','feeling-overwhelmed.png']].map(([title,text,link,image])=><a class="surface card" href={`/${lang}/learn`}><img class="card-illustration" src={`/images/${image}`} alt=""/><h3>{title}</h3><p class="muted">{text}</p><span>Read about {link} →</span></a>)}</div></section>
<section class="shell split section"><div class="visual surface"><div class="mini-orb"></div><p>One guided step<br/>at a time</p></div><div><p class="eyebrow">Free browser tools</p><h2>Try a practical exercise, right here.</h2><p class="muted">Choose guided breathing, grounding, a two-minute pause, calming sounds or a gentle reminder. Each tool works in your browser, with no account needed.</p><a href={`/${lang}/tools`} class="button button-secondary">Explore free browser tools</a></div></section>
<section class="shell section"><p class="eyebrow">How it works</p><h2>Three unhurried steps</h2><ol class="steps"><li><span>1</span><div><h3>Arrive</h3><p class="muted">Choose what feels most helpful right now, breathing, grounding, sleep or learning.</p></div></li><li><span>2</span><div><h3>Follow one cue</h3><p class="muted">Move at your own pace. You can pause, skip or come back later.</p></div></li><li><span>3</span><div><h3>Take the next kind step</h3><p class="muted">Use what helps, reach out when you need to, and return whenever you like.</p></div></li></ol></section>
<section class="shell section"><p class="eyebrow">A note on reviews</p><h2>Real voices belong here.</h2><div class="surface placeholder"><p>Verified App Store reviews can appear here when they are available. Calm SOS will never invent testimonials or outcomes.</p></div></section>
<section class="shell section faq"><p class="eyebrow">Questions</p><h2>A few things you might be wondering</h2><details open><summary>Can I use Calm Now without signing up?</summary><p>Yes. The browser tools are free, private and do not require an account.</p></details><details><summary>Is this a replacement for therapy or medical care?</summary><p>No. Calm SOS offers general wellbeing information and simple self-guided exercises. A qualified professional can offer individual support.</p></details><details><summary>What if I feel unsafe or need urgent help?</summary><p>Please use local emergency support. Our <a href={`/${lang}/crisis-help`}>crisis help page</a> lists starting points and needs verification before launch.</p></details></section>
<div id="download" class="shell"><AppStoreCTA /></div>
</BaseLayout>
<style>.hero{position:relative;min-height:min(760px,calc(100svh - 75px));display:grid;isolation:isolate;overflow:hidden;border-bottom:1px solid color-mix(in srgb,var(--primary) 20%,transparent)}.hero-wash{position:absolute;inset:0;width:100%;height:100%;background:linear-gradient(90deg,color-mix(in srgb,#f8f6ff 74%,transparent) 0%,color-mix(in srgb,#f8f6ff 54%,transparent) 35%,color-mix(in srgb,#f8f6ff 8%,transparent) 68%,transparent 100%);z-index:1}.hero-inner{width:min(1120px,calc(100% - 2rem));position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(4rem,9vw,7.5rem) 0}.hero-copy{max-width:570px}.hero h1{margin:.45rem 0 1.2rem;max-width:11ch}.lead{font-size:1.2rem;color:#4B2C6B}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.7rem 0}.small{font-size:.9rem;color:#543574}.hero-pause{position:absolute;right:0;bottom:clamp(2rem,6vw,5rem);display:flex;align-items:center;gap:.8rem;padding:.9rem 1rem;background:color-mix(in srgb,var(--card) 82%,transparent);box-shadow:0 13px 40px #37314e20;backdrop-filter:blur(10px)}.hero-pause p{margin:.15rem 0 0;color:var(--muted);font-size:.86rem}.pause-orb{width:3rem;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f5f1ff,#8a7bca);box-shadow:0 0 0 8px #6a5fa818}.mini-orb{width:150px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,#8778c9);box-shadow:0 0 0 20px #6a5fa81c}.section{padding:4.5rem 0}.section h2{margin-top:.4rem}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.card{padding:1.25rem;text-decoration:none;color:var(--text);transition:transform .2s}.card:hover{transform:translateY(-4px)}.card-illustration{display:block;width:4.5rem;height:4.5rem;object-fit:contain;margin:0 0 1rem}.split{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}.visual{min-height:320px;display:grid;place-content:center;text-align:center;font-size:1.2rem;font-weight:700}.mini-orb{margin:auto auto 1rem}.steps{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.steps li{display:flex;gap:1rem}.steps span{flex:0 0 2.2rem;height:2.2rem;border-radius:50%;display:grid;place-items:center;background:var(--primary);color:var(--primary-ink);font-weight:800}.steps h3{margin:0}.steps p{margin:.3rem 0}.placeholder{padding:1.5rem}.faq{max-width:800px}.faq details{border-top:1px solid var(--border);padding:1rem 0}.faq summary{cursor:pointer;font-weight:750}@media(max-width:760px){.hero{min-height:760px}.hero-wash{background:linear-gradient(180deg,color-mix(in srgb,#f8f6ff 70%,transparent),color-mix(in srgb,#f8f6ff 47%,transparent) 56%,color-mix(in srgb,#f8f6ff 12%,transparent))}.hero-inner{justify-content:flex-start;padding-top:7rem}.hero-pause{right:auto;left:1rem;bottom:2rem}.split{grid-template-columns:1fr}.cards,.steps{grid-template-columns:1fr 1fr}}@media(max-width:470px){.cards,.steps{grid-template-columns:1fr}.hero h1{font-size:clamp(2.45rem,13vw,3.5rem)}.actions{display:grid}.actions .button{width:100%}}</style>
