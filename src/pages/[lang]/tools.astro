---
import BaseLayout from '../../components/BaseLayout.astro'; import BreathingTool from '../../components/BreathingTool.astro'; import { languages, type Language } from '../../config';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))} const {lang='en'}=(Astro.params ?? {}) as {lang?:Language};
---
<BaseLayout lang={lang} title="Free browser tools | Calm SOS" description="Guided breathing, grounding, a two-minute pause, calming sounds and gentle reminders."><section class="shell intro"><p class="eyebrow">Free browser tools</p><h1>Choose an exercise or a quiet moment.</h1><p class="lead">Use these self-guided tools at your own pace. They are not healthcare or a diagnosis.</p></section><section class="shell grid"><a class="surface tool" href={`/${lang}/calm-now`}><p class="eyebrow">Breathing and grounding</p><h2>Follow a guided exercise</h2><p class="muted">Use a breathing circle or a 5–4–3–2–1 exercise that guides you through your surroundings.</p><span>Open breathing and grounding →</span></a><a class="surface tool" href={`/${lang}/tools/pause`}><p class="eyebrow">Two-minute pause</p><h2>Make a little space</h2><p class="muted">Start a quiet two-minute timer, with optional ocean waves if you would like sound.</p><span>Take a two-minute pause →</span></a><a class="surface tool" href={`/${lang}/tools/sounds`}><p class="eyebrow">Calming sounds</p><h2>Choose rain or ocean waves</h2><p class="muted">Play one soundscape at a time, choose a volume and set an optional sleep timer.</p><span>Open calming sounds →</span></a><a class="surface tool" href={`/${lang}/tools/reassurance`}><p class="eyebrow">Gentle reminders</p><h2>Read a grounded reminder</h2><p class="muted">A few simple words for a difficult moment, with links to a pause or grounding exercise.</p><span>Open gentle reminders →</span></a></section><section class="shell breathing-wrap"><BreathingTool lang={lang}/></section></BaseLayout>
<style>.intro{padding:4.5rem 0 2rem;max-width:780px}.intro h1{margin:.4rem 0}.lead{font-size:1.2rem;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.tool{padding:1.5rem;color:var(--text);text-decoration:none}.tool h2{font-size:1.55rem;margin:.4rem 0}.tool:hover{border-color:var(--primary)}.breathing-wrap{margin-top:3rem;margin-bottom:4rem}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
